<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="org.example.models.Student">
        <id name="id" type="java.lang.Long">
            <generator class="identity"/><!-- генерируемый со стороны БД -->
        </id>
        <property name="firstName" column="first_name"/>
        <property name="lastName" column="last_name"/>

        <bag name="courses" table="student_course"><!-- bag - потому что нужно вернуть данный для коллекции типа List -->
            <key>
                <column name="student_id" not-null="true"/>
            </key>
            <many-to-many entity-name="org.example.models.Course">
                <column name="course_id" not-null="true"/>
            </many-to-many>
        </bag>
    </class>
</hibernate-mapping>